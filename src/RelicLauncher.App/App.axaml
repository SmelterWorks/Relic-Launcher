<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelicLauncher.App.App"
             xmlns:local="using:RelicLauncher.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <!-- Shrinks the whole Fluent scrollbar (track, thumb, buttons) consistently.
         Overriding the ScrollBar's own Width/Height directly breaks the built-in
         collapse render transform, which assumes this resource as its base size. -->
    <x:Double x:Key="ScrollBarSize">14</x:Double>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RelicLauncher.App/Styles/ComboBox.axaml" />
    <StyleInclude Source="avares://RelicLauncher.App/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
