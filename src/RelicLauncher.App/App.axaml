<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelicLauncher.App.App"
             xmlns:local="using:RelicLauncher.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RelicLauncher.App/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
