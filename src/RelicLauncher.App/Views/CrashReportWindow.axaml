<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RelicLauncher.App.ViewModels"
        x:Class="RelicLauncher.App.Views.CrashReportWindow"
        x:DataType="vm:CrashReportWindowViewModel"
        Title="Relic Launcher Error"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="{Binding Heading}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding Subheading}"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>

    <TextBox Grid.Row="1"
             Text="{Binding ReportText}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             FontFamily="Consolas,Courier New,monospace"
             FontSize="12"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" />

    <StackPanel Grid.Row="2"
                Spacing="8"
                Margin="0,16,0,0">
      <TextBlock Text="{Binding CopyStatusMessage}"
                 Classes="muted"
                 HorizontalAlignment="Right"
                 IsVisible="{Binding CopyStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
      <Button Classes="ghost"
              Content="Open logs folder"
              Command="{Binding OpenLogsCommand}" />
      <Button Classes="ghost"
              Content="Copy report"
              Command="{Binding CopyReportCommand}" />
      <Button Classes="primary"
              Content="Close"
              Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
