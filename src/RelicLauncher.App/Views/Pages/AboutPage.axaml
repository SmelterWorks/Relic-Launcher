<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             xmlns:services="using:RelicLauncher.App.Services"
             x:Class="RelicLauncher.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutViewModel">
  <StackPanel Spacing="14" MaxWidth="640">
    <Image Source="{x:Static services:AppBranding.AboutLogoUri}"
           Width="96"
           Height="96"
           Stretch="Uniform"
           HorizontalAlignment="Left"
           AutomationProperties.Name="Relic Launcher logo" />
    <controls:PageHeader Title="{Binding Title}" Subtitle="Build info, links, and license." />
    <TextBlock Text="{Binding Version, StringFormat=Version {0} Unofficial Launcher}" Classes="muted" />
    <TextBlock Text="{Binding CommitSha, StringFormat=Commit {0}}" Classes="muted" />
    <TextBlock Text="{Binding BuildTimeUtc, StringFormat=Built {0} UTC}" Classes="muted" />
    <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="15" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="ghost"
              Content="GitHub"
              Command="{Binding OpenRepositoryCommand}"
              AutomationProperties.Name="Open GitHub repository" />
      <Button Classes="ghost"
              Content="Report issue"
              Command="{Binding OpenIssuesCommand}"
              AutomationProperties.Name="Open GitHub issues" />
      <Button Classes="ghost"
              Content="Vintage Story"
              Command="{Binding OpenVintageStoryCommand}"
              AutomationProperties.Name="Open Vintage Story website" />
    </StackPanel>

    <controls:FolderPathRow DataContext="{Binding LogsFolder}" Margin="0,8,0,0" />

    <TextBlock Text="{Binding StatusMessage}"
               Classes="muted"
               AutomationProperties.LiveSetting="Polite"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Text="License: 0BSD" Classes="muted" />
  </StackPanel>
</UserControl>
