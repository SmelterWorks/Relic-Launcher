<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="RelicLauncher.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="720">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <controls:PageHeader Grid.Column="0"
                             Title="Settings"
                             Subtitle="Sign in, pick folders, change the look. Advanced stuff is tucked away below." />
        <TextBlock Grid.Column="1"
                   Text="{Binding SaveStatusMessage}"
                   Classes="muted"
                   Classes.error="{Binding SaveStatusIsError}"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"
                   IsVisible="{Binding IsSaveStatusVisible}" />
      </Grid>

      <controls:SettingsSection Title="Account"
                                Subtitle="Sign in so Play can auto-fill your Vintage Story game session. Downloads do not need this."
                                IsExpanded="{Binding IsAccountSectionExpanded}">
        <controls:SettingsSection.SectionContent>
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding AccountStatus}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AccountError}"
                       Foreground="{DynamicResource Theme.Danger}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasAccountError}" />
            <TextBlock Text="Same game account email and password as the official client. Relic never stores your password."
                       Classes="settings-field-hint"
                       IsVisible="{Binding !IsSignedIn}" />
            <StackPanel Spacing="8" IsVisible="{Binding !IsSignedIn}">
              <TextBox x:Name="AccountEmailBox"
                       Text="{Binding AccountEmail}"
                       PlaceholderText="Email"
                       IsEnabled="{Binding !IsSigningIn}"
                       KeyDown="OnAccountFieldKeyDown"
                       AutomationProperties.Name="Account email" />
              <TextBox Text="{Binding AccountPassword}"
                       PasswordChar="*"
                       PlaceholderText="Password"
                       IsEnabled="{Binding !IsSigningIn}"
                       KeyDown="OnAccountFieldKeyDown"
                       AutomationProperties.Name="Account password" />
              <StackPanel Spacing="4" IsVisible="{Binding RequiresTotp}">
                <TextBlock Text="Access code (2FA)" Classes="settings-field-label" />
                <TextBox Text="{Binding AccountTotpCode}"
                         PlaceholderText="6-digit code"
                         MaxLength="8"
                         IsEnabled="{Binding !IsSigningIn}"
                         KeyDown="OnAccountFieldKeyDown"
                         AutomationProperties.Name="Two-factor access code" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary"
                        Content="{Binding SignInButtonText}"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding !IsSigningIn}" />
                <TextBlock Text="Signing in..."
                           Classes="muted"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsSigningIn}" />
              </StackPanel>
            </StackPanel>
            <Button Classes="ghost"
                    Content="Sign out"
                    Command="{Binding SignOutCommand}"
                    IsVisible="{Binding IsSignedIn}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </controls:SettingsSection.SectionContent>
      </controls:SettingsSection>

      <controls:SettingsSection Title="Game folders"
                                Subtitle="Where Relic installs versions, and where Vintage Story keeps saves and mods."
                                IsExpanded="True">
        <controls:SettingsSection.SectionContent>
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Installs folder" Classes="settings-field-label" />
              <TextBlock Text="Game versions download here." Classes="settings-field-hint" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding InstallsRoot}"
                         PlaceholderText="Folder for Relic game installs" />
                <Button Grid.Column="1"
                        Classes="ghost"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTip.Tip="Browse"
                        Command="{Binding BrowseInstallsRootCommand}">
                  <i:Icon Value="mdi-folder" Width="18" Height="18" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Game data folder" Classes="settings-field-label" />
              <TextBlock Text="Saves, mods, and configs. Usually VintagestoryData." Classes="settings-field-hint" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding DataPath}"
                         PlaceholderText="Folder for saves and mods" />
                <Button Grid.Column="1"
                        Classes="ghost"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTip.Tip="Browse"
                        Command="{Binding BrowseDataPathCommand}">
                  <i:Icon Value="mdi-folder" Width="18" Height="18" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Active version" Classes="settings-field-label" />
              <TextBlock Text="{Binding SelectedVersion}"
                         Classes="muted"
                         IsVisible="{Binding SelectedVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="None selected yet. Pick one on the Versions page."
                         Classes="settings-field-hint"
                         IsVisible="{Binding SelectedVersion, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextBlock Text="Change this on the Versions page."
                         Classes="settings-field-hint"
                         IsVisible="{Binding SelectedVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </controls:SettingsSection.SectionContent>
      </controls:SettingsSection>

      <controls:SettingsSection Title="Look and feel"
                                Subtitle="Theme, home screen logo, and exit prompt."
                                IsExpanded="True">
        <controls:SettingsSection.SectionContent>
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Theme" Classes="settings-field-label" />
              <ComboBox ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding SelectedTheme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Home background logo" Classes="settings-field-label" />
              <ComboBox ItemsSource="{Binding LogoModeOptions}"
                        SelectedItem="{Binding SelectedLogoModeOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogoModeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsCustomLogoMode}" Spacing="4">
              <TextBlock Text="Custom logo file" Classes="settings-field-label" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Text="{Binding HomeBackgroundCustomLogoPath}"
                         PlaceholderText="Path to a PNG or JPG" />
                <Button Grid.Column="1"
                        Classes="ghost"
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTip.Tip="Pick image"
                        Command="{Binding BrowseCustomLogoPathCommand}">
                  <i:Icon Value="mdi-file-image" Width="18" Height="18" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Logo opacity" Classes="settings-field-label" />
              <Slider Minimum="0.02"
                      Maximum="0.35"
                      Value="{Binding HomeBackgroundLogoOpacity}"
                      TickFrequency="0.01"
                      IsSnapToTickEnabled="True" />
            </StackPanel>

            <CheckBox Content="Ask before closing Relic"
                      IsChecked="{Binding ConfirmBeforeExit}" />
            <CheckBox Content="Warn before installing mods on the official blocklist"
                      IsChecked="{Binding WarnOnBlockedMods}" />

            <StackPanel Spacing="4">
              <TextBlock Text="Mod updates" Classes="settings-field-label" />
              <ComboBox ItemsSource="{Binding ModUpdateModeOptions}"
                        SelectedItem="{Binding SelectedModUpdateModeOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModUpdateModeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding SelectedModUpdateModeOption.Description}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SelectedModUpdateModeOption, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Launcher updates" Classes="settings-field-label" />
              <ComboBox ItemsSource="{Binding LauncherUpdateModeOptions}"
                        SelectedItem="{Binding SelectedLauncherUpdateModeOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LauncherUpdateModeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding SelectedLauncherUpdateModeOption.Description}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SelectedLauncherUpdateModeOption, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ComboBox ItemsSource="{Binding LauncherUpdateChannelOptions}"
                        SelectedItem="{Binding SelectedLauncherUpdateChannelOption}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LauncherUpdateChannelOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding SelectedLauncherUpdateChannelOption.Description}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         IsVisible="{Binding SelectedLauncherUpdateChannelOption, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </controls:SettingsSection.SectionContent>
      </controls:SettingsSection>

      <controls:SettingsSection Title="Service URLs"
                                Subtitle="Only change these if you are testing a mirror or custom endpoint."
                                IsExpanded="False">
        <controls:SettingsSection.SectionContent>
          <StackPanel Spacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Account" Classes="settings-field-label" />
              <TextBox Text="{Binding AccountBaseUrl}"
                       PlaceholderText="https://account.vintagestory.at/" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="CDN" Classes="settings-field-label" />
              <TextBox Text="{Binding CdnBaseUrl}"
                       PlaceholderText="https://cdn.vintagestory.at/" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="ModDB API" Classes="settings-field-label" />
              <TextBox Text="{Binding ModDbApiBaseUrl}"
                       PlaceholderText="https://mods.vintagestory.at/api/" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="ModDB downloads" Classes="settings-field-label" />
              <TextBox Text="{Binding ModDbDownloadBaseUrl}"
                       PlaceholderText="https://mods.vintagestory.at/download" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Version list" Classes="settings-field-label" />
              <TextBox Text="{Binding VersionCatalogUrl}"
                       PlaceholderText="https://api.vintagestory.at/stable-unstable.json" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Latest stable" Classes="settings-field-label" />
              <TextBox Text="{Binding LatestStableUrl}"
                       PlaceholderText="https://api.vintagestory.at/lateststable.txt" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="News blog" Classes="settings-field-label" />
              <TextBox Text="{Binding NewsBlogUrl}"
                       PlaceholderText="https://www.vintagestory.at/blog.html/" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Wiki" Classes="settings-field-label" />
              <TextBox Text="{Binding WikiBaseUrl}"
                       PlaceholderText="https://wiki.vintagestory.at/" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Public server list" Classes="settings-field-label" />
              <TextBox Text="{Binding ServerListUrl}"
                       PlaceholderText="https://smelterworks.com/api/v1/servers/list" />
            </StackPanel>
            <Button Classes="ghost"
                    Content="Reset URLs to defaults"
                    Command="{Binding ResetEndpointUrlsCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </controls:SettingsSection.SectionContent>
      </controls:SettingsSection>

      <controls:SettingsSection Title="Troubleshooting"
                                Subtitle="Logs, debug output, and a full settings reset."
                                IsExpanded="False">
        <controls:SettingsSection.SectionContent>
            <StackPanel Spacing="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Process isolation" Classes="settings-field-label" />
              <TextBlock Text="Sandboxes Relic, the game client, and local server with separate policies. Changing installs or data paths needs a restart when this is on."
                         Classes="settings-field-hint"
                         TextWrapping="Wrap" />
              <CheckBox Content="Enable process isolation"
                        IsChecked="{Binding ProcessIsolationEnabled}" />
              <TextBlock Text="{Binding IsolationStatus}"
                         Classes="muted"
                         TextWrapping="Wrap" />
            </StackPanel>

            <controls:FolderPathRow DataContext="{Binding LogsFolder}" />
            <controls:FolderPathRow DataContext="{Binding ThemesFolder}" />

            <StackPanel Spacing="8">
              <TextBlock Text="Debug log" Classes="settings-field-label" />
              <TextBlock Text="Recent warnings and errors from this session." Classes="settings-field-hint" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="Show / hide" Command="{Binding ToggleDebugViewerCommand}" />
                <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshDebugLogCommand}" />
                <Button Classes="ghost" Content="Clear" Command="{Binding ClearDebugLogCommand}" />
              </StackPanel>
              <TextBox Text="{Binding DebugLogText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="180"
                       MaxHeight="320"
                       IsVisible="{Binding ShowDebugViewer}" />
            </StackPanel>

            <Button Classes="ghost"
                    Content="Reset all settings to defaults"
                    Command="{Binding ResetSettingsCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </controls:SettingsSection.SectionContent>
      </controls:SettingsSection>

      <TextBlock Text="{Binding StatusMessage}"
                 Classes="muted"
                 Classes.error="{Binding StatusIsError}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
