<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="RelicLauncher.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="720">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <controls:PageHeader Grid.Column="0"
                             Title="Settings"
                             Subtitle="Account, installs, data path, theme, endpoints, and logs." />
        <TextBlock Grid.Column="1"
                   Text="{Binding SaveStatusMessage}"
                   Classes="muted"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"
                   IsVisible="{Binding IsSaveStatusVisible}" />
      </Grid>

      <TextBlock Text="Vintage Story account" Margin="0,12,0,0" Classes="brand" FontSize="18" />
      <TextBlock Text="{Binding AccountStatus}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding AccountError}"
                 Foreground="{DynamicResource Theme.Danger}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasAccountError}" />
      <TextBlock Text="The account portal requires captcha, so Relic opens an in-app browser to sign in. Optional: enter your email to label the saved session."
                 Classes="muted"
                 TextWrapping="Wrap" />
      <TextBox Text="{Binding AccountEmail}"
               PlaceholderText="game account email (optional label)"
               IsEnabled="{Binding !IsSignedIn}"
               VerticalContentAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="primary"
                Content="Sign in with browser"
                Command="{Binding SignInCommand}"
                IsVisible="{Binding !IsSignedIn}"
                IsEnabled="{Binding !IsSigningIn}" />
        <Button Classes="ghost"
                Content="Sign out"
                Command="{Binding SignOutCommand}"
                IsVisible="{Binding IsSignedIn}" />
        <TextBlock Text="Waiting for browser sign-in..."
                   Classes="muted"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsSigningIn}" />
      </StackPanel>

      <TextBlock Text="Installs root" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding InstallsRoot}"
                 PlaceholderText="/path/to/RelicLauncher/Vintagestory" />
        <Button Grid.Column="1"
                Classes="ghost"
                Width="40"
                Height="40"
                Padding="0"
                ToolTip.Tip="Select installs root"
                Command="{Binding BrowseInstallsRootCommand}">
          <i:Icon Value="mdi-folder" Width="18" Height="18" />
        </Button>
      </Grid>

      <TextBlock Text="Game data path" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 Text="{Binding DataPath}"
                 PlaceholderText="/path/to/VintagestoryData" />
        <Button Grid.Column="1"
                Classes="ghost"
                Width="40"
                Height="40"
                Padding="0"
                ToolTip.Tip="Select data folder"
                Command="{Binding BrowseDataPathCommand}">
          <i:Icon Value="mdi-folder" Width="18" Height="18" />
        </Button>
      </Grid>

      <TextBlock Text="Active version" Margin="0,8,0,0" />
      <TextBlock Text="{Binding SelectedVersion}" Classes="muted" />
      <TextBlock Text="Choose the active version on the Versions page." Classes="muted" FontSize="12" />

      <TextBlock Text="Theme" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding Themes}"
                SelectedItem="{Binding SelectedTheme}"
                MinWidth="280">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="Home background logo" Margin="0,8,0,0" />
      <ComboBox ItemsSource="{Binding LogoModeOptions}"
                SelectedItem="{Binding SelectedLogoModeOption}"
                MinWidth="280">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogoModeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel IsVisible="{Binding IsCustomLogoMode}" Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="Custom logo file path" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding HomeBackgroundCustomLogoPath}"
                   PlaceholderText="/path/to/logo.png" />
          <Button Grid.Column="1"
                  Classes="ghost"
                  Width="40"
                  Height="40"
                  Padding="0"
                  ToolTip.Tip="Select image file"
                  Command="{Binding BrowseCustomLogoPathCommand}">
            <i:Icon Value="mdi-file-image" Width="18" Height="18" />
          </Button>
        </Grid>
      </StackPanel>

      <StackPanel Spacing="6" Margin="0,8,0,0">
        <TextBlock Text="Logo opacity" />
        <Slider Minimum="0.02"
                Maximum="0.35"
                Value="{Binding HomeBackgroundLogoOpacity}"
                TickFrequency="0.01"
                IsSnapToTickEnabled="True" />
      </StackPanel>

      <CheckBox Content="Confirm before exit"
                IsChecked="{Binding ConfirmBeforeExit}"
                Margin="0,8,0,0" />

      <TextBlock Text="Service URLs" Margin="0,16,0,0" Classes="brand" FontSize="18" />
      <TextBlock Text="Override Vintage Story account, CDN, ModDB, version catalog, and news endpoints. Leave blank or reset to use defaults."
                 Classes="muted"
                 TextWrapping="Wrap" />

      <TextBlock Text="Account base URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding AccountBaseUrl}"
               PlaceholderText="https://account.vintagestory.at/"
               VerticalContentAlignment="Center" />

      <TextBlock Text="CDN base URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding CdnBaseUrl}"
               PlaceholderText="https://cdn.vintagestory.at/"
               VerticalContentAlignment="Center" />

      <TextBlock Text="ModDB API base URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding ModDbApiBaseUrl}"
               PlaceholderText="https://mods.vintagestory.at/api/"
               VerticalContentAlignment="Center" />

      <TextBlock Text="ModDB download URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding ModDbDownloadBaseUrl}"
               PlaceholderText="https://mods.vintagestory.at/download"
               VerticalContentAlignment="Center" />

      <TextBlock Text="Version catalog URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding VersionCatalogUrl}"
               PlaceholderText="https://api.vintagestory.at/stable-unstable.json"
               VerticalContentAlignment="Center" />

      <TextBlock Text="Latest stable URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding LatestStableUrl}"
               PlaceholderText="https://api.vintagestory.at/lateststable.txt"
               VerticalContentAlignment="Center" />

      <TextBlock Text="News blog URL" Margin="0,8,0,0" />
      <TextBox Text="{Binding NewsBlogUrl}"
               PlaceholderText="https://www.vintagestory.at/blog.html/"
               VerticalContentAlignment="Center" />

      <Button Classes="ghost"
              Content="Reset endpoint URLs"
              Command="{Binding ResetEndpointUrlsCommand}"
              HorizontalAlignment="Left"
              Margin="0,8,0,0" />

      <Button Classes="ghost"
              Content="Reset settings to defaults"
              Command="{Binding ResetSettingsCommand}"
              HorizontalAlignment="Left"
              Margin="0,8,0,0" />

      <controls:FolderPathRow DataContext="{Binding LogsFolder}" Margin="0,12,0,0" />
      <controls:FolderPathRow DataContext="{Binding ThemesFolder}" Margin="0,8,0,0" />

      <TextBlock Text="Debug viewer" Margin="0,16,0,0" Classes="brand" FontSize="18" />
      <TextBlock Text="Recent warnings and errors from this session." Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="Show / hide" Command="{Binding ToggleDebugViewerCommand}" />
        <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshDebugLogCommand}" />
        <Button Classes="ghost" Content="Clear" Command="{Binding ClearDebugLogCommand}" />
      </StackPanel>
      <TextBox Text="{Binding DebugLogText}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="180"
               MaxHeight="320"
               IsVisible="{Binding ShowDebugViewer}" />

      <TextBlock Text="{Binding StatusMessage}"
                 Classes="muted"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
