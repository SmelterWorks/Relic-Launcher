<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:models="using:RelicLauncher.Core.Models"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="RelicLauncher.App.Views.Pages.ModsPage"
             x:DataType="vm:ModsViewModel">
  <Grid>
  <Grid RowDefinitions="Auto,Auto,*">
    <controls:PageHeader Title="Mods"
                         Subtitle="Browse ModDB and manage mods in your data folder." />

    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding SearchText}"
                 PlaceholderText="Search mods"
                 Width="240"
                 MinWidth="160"
                 Height="40"
                 VerticalContentAlignment="Center"
                 VerticalAlignment="Center"
                 KeyDown="OnSearchKeyDown"
                 AutomationProperties.Name="Search mods" />
        <Button Classes="primary" Content="Search" Command="{Binding SearchCommand}" IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="Search ModDB" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSortOption}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModSortOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding SideFilterOptions}"
                  SelectedItem="{Binding SelectedSideFilter}"
                  VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModSideFilterOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="ghost"
                Content="{Binding TagsMenuLabel}"
                VerticalAlignment="Center"
                Padding="12,8"
                AutomationProperties.Name="Tag filters">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <DockPanel Width="240" MaxHeight="300">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="Tags" Classes="muted" VerticalAlignment="Center" />
                  <Button Classes="ghost"
                          Content="Clear"
                          Padding="8,4"
                          Command="{Binding ClearSelectedTagsCommand}"
                          IsVisible="{Binding HasSelectedTags}"
                          VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding TagChips}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModTagChipViewModel">
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Margin="0,2"
                                  Command="{Binding ToggleCommand}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <CheckBox Content="Filter by active version"
                  IsChecked="{Binding FilterByActiveVersion}"
                  IsEnabled="{Binding CanFilterByActiveVersion}"
                  ToolTip.Tip="{Binding FilterByActiveVersionHint}"
                  VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Classes="muted"
                 Classes.error="{Binding StatusIsError}"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <ItemsControl ItemsSource="{Binding ActiveTransfers}"
                    IsVisible="{Binding ActiveTransfers.Count}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TransferJobRowViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,6">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid x:Name="BrowseDetailGrid" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">
      <Grid Grid.Column="0" RowDefinitions="*">
        <TabControl AutomationProperties.Name="Mods tabs">
          <TabItem Header="Browse">
            <Grid RowDefinitions="*,Auto">
              <Grid Grid.Row="0">
                <controls:LoadingOverlay IsActive="{Binding IsLoading}"
                                         Message="Loading mods…" />
                <controls:EmptyStatePanel Message="{Binding EmptyBrowseMessage}"
                                          IsActive="{Binding ShowEmptyBrowse}" />
                <ListBox x:Name="BrowseModsList"
                         ItemsSource="{Binding BrowseResults}"
                       SelectedItem="{Binding SelectedBrowseMod, Mode=TwoWay}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ContainerPrepared="OnBrowseContainerPrepared">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModRowViewModel">
                      <Border Classes="list-row"
                              Margin="0,0,0,6"
                              Padding="10">
                        <Grid ColumnDefinitions="56,*" ColumnSpacing="10">
                          <Border Width="48" Height="48" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Theme.Bg1}">
                            <Panel>
                              <Image Source="{Binding Logo}" Stretch="UniformToFill" IsVisible="{Binding !IsLogoLoading}" />
                              <TextBlock Text="..."
                                         Classes="muted"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsLogoLoading}" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Author}" Classes="muted" />
                            <TextBlock Text="{Binding DownloadsLabel}" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding TagsLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasTags}" />
                            <TextBlock Text="{Binding SummaryText}" Classes="muted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </Grid>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Classes="ghost" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" />
                <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" />
                <Button Classes="ghost" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" />
              </StackPanel>
            </Grid>
          </TabItem>

          <TabItem Header="Installed">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Spacing="8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost"
                          Content="Check for updates"
                          Command="{Binding CheckForUpdatesCommand}"
                          IsEnabled="{Binding !IsCheckingUpdates}"
                          IsVisible="{Binding ShowCheckForUpdates}"
                          AutomationProperties.Name="Check for mod updates" />
                  <Button Classes="primary"
                          Content="Update all"
                          Command="{Binding UpdateAllCommand}"
                          IsEnabled="{Binding CanUpdateAll}"
                          IsVisible="{Binding CanUpdateAll}"
                          AutomationProperties.Name="Update all mods" />
                  <Button Classes="ghost"
                          Content="Add folder"
                          Command="{Binding ImportLocalFolderCommand}"
                          AutomationProperties.Name="Import local mod folder" />
                  <Button Classes="ghost"
                          Content="Add zip"
                          Command="{Binding ImportLocalZipCommand}"
                          AutomationProperties.Name="Import local mod zip" />
                  <Button Classes="ghost"
                          Content="Clean duplicates"
                          Command="{Binding CleanDuplicatesCommand}"
                          IsVisible="{Binding HasDuplicateMods}"
                          AutomationProperties.Name="Clean duplicate mods" />
                </StackPanel>
                <TextBlock Text="{Binding DuplicateModsMessage}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasDuplicateMods}" />
                <TextBlock Text="{Binding UpdateStatusMessage}"
                           Classes="muted"
                           Classes.error="{Binding UpdateStatusIsError}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Checking for updates…"
                           Classes="muted"
                           IsVisible="{Binding IsCheckingUpdates}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <controls:EmptyStatePanel Message="{Binding EmptyInstalledMessage}"
                                          IsActive="{Binding !HasInstalledMods}" />
                <ListBox x:Name="InstalledModsList"
                         ItemsSource="{Binding InstalledMods}"
                       SelectedItem="{Binding SelectedInstalledMod, Mode=TwoWay}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ContainerPrepared="OnInstalledContainerPrepared">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledModRowViewModel">
                      <Border Classes="list-row"
                              Margin="0,0,0,8"
                              Padding="10">
                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10">
                          <Border Width="48" Height="48" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Theme.Bg1}">
                            <Panel>
                              <Image Source="{Binding Logo}" Stretch="UniformToFill" IsVisible="{Binding !IsLogoLoading}" />
                              <TextBlock Text="..."
                                         Classes="muted"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding IsLogoLoading}" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Classes="muted" IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding FileName}" Classes="muted" FontSize="12" />
                            <TextBlock Text="{Binding TagsLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasTags}" />
                            <TextBlock Text="Disabled" Classes="muted" IsVisible="{Binding !IsEnabled}" />
                            <TextBlock Text="{Binding DependencyStatusLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Danger}"
                                       IsVisible="{Binding HasDependencyProblems}" />
                            <TextBlock Text="{Binding DependencyStatusLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       IsVisible="{Binding ShowDependencyOk}" />
                            <TextBlock Text="{Binding UpdateStatusLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Accent}"
                                       IsVisible="{Binding HasUpdateAvailable}" />
                            <TextBlock Text="{Binding RecentlyUpdatedLabel}"
                                       Classes="muted"
                                       FontSize="12"
                                       Foreground="{DynamicResource Theme.Accent}"
                                       IsVisible="{Binding WasRecentlyUpdated}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="ghost"
                                    Content="Update"
                                    IsVisible="{Binding HasUpdateAvailable}"
                                    Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).UpdateInstalledModCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="Update mod" />
                            <Button Classes="ghost"
                                    Content="Disable"
                                    IsVisible="{Binding IsEnabled}"
                                    Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).ToggleModCommand}"
                                    CommandParameter="{Binding Info}"
                                    AutomationProperties.Name="Disable mod" />
                            <Button Classes="ghost"
                                    Content="Enable"
                                    IsVisible="{Binding !IsEnabled}"
                                    Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).ToggleModCommand}"
                                    CommandParameter="{Binding Info}"
                                    AutomationProperties.Name="Enable mod" />
                            <Button Classes="ghost"
                                    Padding="8,6"
                                    ToolTip.Tip="More actions"
                                    AutomationProperties.Name="More mod actions">
                              <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                  <MenuItem Header="Open folder"
                                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).OpenModFolderCommand}"
                                            CommandParameter="{Binding Info}" />
                                  <MenuItem Header="Uninstall"
                                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).UninstallModCommand}"
                                            CommandParameter="{Binding Info}" />
                                </MenuFlyout>
                              </Button.Flyout>
                              <i:Icon Value="mdi-dots-vertical" Width="18" Height="18" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Modpacks">
            <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding ModpackPanel}">
              <StackPanel Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="Save current enabled mods as a modpack or apply a saved or imported pack."
                           Classes="muted"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding NewPackName}"
                         PlaceholderText="Modpack name"
                         AutomationProperties.Name="Modpack name" />
                <TextBox Text="{Binding NewPackDescription}"
                         PlaceholderText="Description (optional)"
                         AcceptsReturn="True"
                         MinHeight="48"
                         AutomationProperties.Name="Modpack description" />
                <TextBlock Text="{Binding DistributionNote}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding DistributionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary"
                          Content="Save from installed"
                          Command="{Binding SaveFromInstalledCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          AutomationProperties.Name="Save modpack from installed mods" />
                  <Button Classes="ghost"
                          Content="Import replace"
                          ToolTip.Tip="Replace all enabled mods with the imported pack contents"
                          Command="{Binding ImportAndApplyReplaceCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          AutomationProperties.Name="Import modpack replace" />
                  <Button Classes="ghost"
                          Content="Import merge"
                          ToolTip.Tip="Add mods from the imported pack without removing existing enabled mods"
                          Command="{Binding ImportAndApplyMergeCommand}"
                          IsEnabled="{Binding !IsBusy}"
                          AutomationProperties.Name="Import modpack merge" />
                  <Button Classes="ghost"
                          Content="Refresh"
                          Command="{Binding RefreshCommand}"
                          AutomationProperties.Name="Refresh modpacks" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding ActiveTransfers}"
                              IsVisible="{Binding ActiveTransfers.Count}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferJobRowViewModel">
                      <StackPanel Spacing="4" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Classes="muted" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Grid.Row="1"
                         Text="No saved modpacks yet."
                         Classes="muted"
                         Margin="0,0,0,8"
                         IsVisible="{Binding !HasSavedPacks}" />

              <ListBox Grid.Row="2"
                       ItemsSource="{Binding SavedPacks}"
                       Background="Transparent"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModpackRowViewModel">
                    <Border Background="{DynamicResource Theme.Surface}"
                            Padding="12"
                            Margin="0,0,0,8"
                            CornerRadius="{DynamicResource Theme.Radius}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="muted" FontSize="12">
                          <Run Text="{Binding GameVersion}" />
                          <Run Text=" · " />
                          <Run Text="{Binding ModCount}" />
                          <Run Text=" mods · " />
                          <Run Text="{Binding DistributionLabel}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost"
                                  Content="Apply replace"
                                  ToolTip.Tip="Replace all enabled mods with this pack"
                                  Command="{Binding $parent[ListBox].((vm:ModpackPanelViewModel)DataContext).ApplyReplaceCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="Apply modpack replace" />
                          <Button Classes="ghost"
                                  Content="Apply merge"
                                  ToolTip.Tip="Add mods from this pack without removing existing enabled mods"
                                  Command="{Binding $parent[ListBox].((vm:ModpackPanelViewModel)DataContext).ApplyMergeCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="Apply modpack merge" />
                          <Button Classes="ghost"
                                  Content="Export"
                                  Command="{Binding $parent[ListBox].((vm:ModpackPanelViewModel)DataContext).ExportCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="Export modpack" />
                          <Button Classes="ghost"
                                  Content="Delete"
                                  Command="{Binding $parent[ListBox].((vm:ModpackPanelViewModel)DataContext).DeleteCommand}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="Delete modpack" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>

      <Border Grid.Column="1"
              Padding="0"
              Background="{DynamicResource Theme.Surface}"
              CornerRadius="{DynamicResource Theme.Radius}"
              ClipToBounds="True">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,16,16,8">
            <TextBlock Text="Details" Classes="brand" FontSize="20" />
            <TextBlock Text="Select a mod to see details."
                       Classes="muted"
                       IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Text="{Binding DetailStatus}"
                       Classes="muted"
                       Classes.error="{Binding DetailStatusIsError}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding DetailStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="Loading details..." Classes="muted" IsVisible="{Binding IsLoadingDetails}" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom"
                  Padding="16,8,16,16"
                  IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding BlocklistWarning}"
                         Foreground="{DynamicResource Theme.Danger}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding BlocklistWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ComboBox Classes="combo-fill"
                        ItemsSource="{Binding SelectedDetails.Releases}"
                        SelectedItem="{Binding SelectedRelease}"
                        PlaceholderText="Select release">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ModReleaseInfo">
                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel IsVisible="{Binding IsInstalling}" Spacing="4">
                <TextBlock Text="{Binding InstallProgressLabel}" Classes="muted" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding InstallProgress}" Height="8" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedInstalledLabel}"
                         Classes="muted"
                         FontWeight="SemiBold"
                         IsVisible="{Binding IsSelectedModInstalled}" />
              <CheckBox Content="Don't auto-update this mod"
                        IsChecked="{Binding IsSelectedModOptedOut, Mode=OneWay}"
                        Command="{Binding ToggleSelectedModUpdateOptOutCommand}"
                        IsVisible="{Binding IsSelectedModInstalled}" />
              <Button Classes="primary"
                      Content="{Binding SelectedUpdateLabel}"
                      Command="{Binding UpdateSelectedCommand}"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding HasSelectedModUpdate}"
                      IsEnabled="{Binding !IsLoadingDetails}" />
              <Button Classes="primary"
                      Content="Install selected release"
                      Command="{Binding InstallSelectedCommand}"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding !IsSelectedModInstalled}"
                      IsEnabled="{Binding !IsLoadingDetails}" />
            </StackPanel>
          </Border>

          <ScrollViewer Margin="16,0,16,0"
                        IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10" Margin="0,0,0,12">
              <Button Classes="ghost"
                      Padding="0"
                      HorizontalAlignment="Left"
                      Command="{Binding OpenDetailLogoCommand}"
                      IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding DetailLogo}"
                       MaxHeight="140"
                       Stretch="Uniform"
                       HorizontalAlignment="Left" />
              </Button>
              <TextBlock Text="{Binding SelectedDetails.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedDetails.Author}" Classes="muted" />
              <TextBlock Text="{Binding SelectedDetails.Summary}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" TextWrapping="Wrap">
                <TextBlock.Text>
                  <MultiBinding StringFormat="Side: {0} · Downloads: {1:N0} · Follows: {2:N0}">
                    <Binding Path="SelectedDetails.Side" />
                    <Binding Path="SelectedDetails.Downloads" />
                    <Binding Path="SelectedDetails.Follows" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding DetailTagNames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="ghost"
                            Margin="0,0,6,6"
                            Padding="8,2"
                            Background="{DynamicResource Theme.Bg1}"
                            Command="{Binding $parent[UserControl].((vm:ModsViewModel)DataContext).ToggleDetailTagCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding}" FontSize="12" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SelectedDetails.DescriptionText}"
                         TextWrapping="Wrap"
                         LineHeight="22" />
              <StackPanel Spacing="4" IsVisible="{Binding HasDependencyRows}">
                <TextBlock Text="Dependencies" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding DependencyRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModDependencyStatusRowViewModel">
                      <TextBlock Text="{Binding Label}"
                                 Classes="muted"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost"
                        Content="ModDB page"
                        Command="{Binding OpenModDbPageCommand}"
                        AutomationProperties.Name="Open mod details on ModDB" />
                <Button Classes="ghost" Content="Homepage" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedDetails.HomepageUrl}"
                        IsVisible="{Binding SelectedDetails.HomepageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="ghost" Content="Wiki" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedDetails.WikiUrl}"
                        IsVisible="{Binding SelectedDetails.WikiUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="ghost" Content="Source" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedDetails.SourceCodeUrl}"
                        IsVisible="{Binding SelectedDetails.SourceCodeUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="ghost" Content="Trailer" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedDetails.TrailerVideoUrl}"
                        IsVisible="{Binding SelectedDetails.TrailerVideoUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ScreenshotItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModImageItemViewModel">
                    <Button Classes="ghost"
                            Padding="0"
                            Margin="0,0,8,8"
                            Command="{Binding OpenCommand}">
                      <Image Source="{Binding Thumbnail}" Width="120" Height="80" Stretch="UniformToFill" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>

    <Border IsVisible="{Binding IsImageViewerOpen}"
            Background="{DynamicResource Theme.Overlay}"
            ZIndex="100"
            Focusable="True"
            KeyDown="OnImageViewerKeyDown">
      <Grid>
        <Button Classes="ghost"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding CloseImageViewerCommand}"
                AutomationProperties.Name="Close image viewer backdrop" />
        <Button Classes="ghost"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Width="44"
                Height="44"
                Padding="0"
                ZIndex="1"
                Command="{Binding CloseImageViewerCommand}"
                ToolTip.Tip="Close (Esc)"
                AutomationProperties.Name="Close image viewer">
          <i:Icon Value="mdi-close" Width="20" Height="20" />
        </Button>
        <Panel ZIndex="1" IsHitTestVisible="True">
          <TextBlock Text="Loading image..."
                     Classes="muted"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding IsViewerLoading}" />
          <Image Source="{Binding ViewerImage}"
                 Margin="48"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding ViewerImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
