<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             x:Class="RelicLauncher.App.Views.Pages.VersionsPage"
             x:DataType="vm:VersionsViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <controls:PageHeader Title="Versions"
                         Subtitle="Download, install, and select Vintage Story client versions." />

    <StackPanel Grid.Row="1" Spacing="10" Margin="0,12,0,12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBox Text="{Binding SearchText}"
                 PlaceholderText="Search versions"
                 Width="200"
                 MinWidth="140"
                 Height="40"
                 VerticalContentAlignment="Center"
                 VerticalAlignment="Center" />
        <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
        <CheckBox Content="Stable" IsChecked="{Binding ShowStable}" />
        <CheckBox Content="Unstable" IsChecked="{Binding ShowUnstable}" />
        <TextBlock Text="{Binding LatestStable, StringFormat=Latest stable: {0}}"
                   Classes="muted"
                   VerticalAlignment="Center"
                   IsVisible="{Binding LatestStable, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding ActiveTransfers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TransferJobRowViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,6">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" />
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Classes="ghost"
              Content="Cancel all"
              Command="{Binding CancelAllInstallsCommand}"
              HorizontalAlignment="Left"
              IsVisible="{Binding IsInstalling}" />

      <TextBlock Text="{Binding StatusMessage}"
                 Classes="muted"
                 TextWrapping="Wrap"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="Loading..." Classes="muted" IsVisible="{Binding IsLoading}" />
      <TextBlock Text="{Binding EmptyMessage}"
                 Classes="muted"
                 IsVisible="{Binding !HasVersions}" />
    </StackPanel>

    <Grid Grid.Row="2" RowDefinitions="*,Auto">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Versions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionRowViewModel">
              <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource Theme.Surface}" CornerRadius="{DynamicResource Theme.Radius}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Classes="muted">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="Channel" />
                          <Binding Path="PackageSummary" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="Installed" Classes="muted" IsVisible="{Binding IsInstalled}" />
                    <TextBlock Text="Active" IsVisible="{Binding IsActive}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding !IsInstalled}" />
                    <Button Classes="ghost" Content="Set active" Command="{Binding SetActiveCommand}" IsVisible="{Binding IsInstalled}" IsEnabled="{Binding !IsActive}" />
                    <Button Classes="ghost" Content="Uninstall" Command="{Binding UninstallCommand}" IsVisible="{Binding IsInstalled}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Classes="ghost" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" />
        <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" />
        <Button Classes="ghost" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
