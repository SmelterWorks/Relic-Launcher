<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             x:Class="RelicLauncher.App.Views.Pages.PlaceholderPage"
             x:DataType="vm:PlaceholderPageViewModel">
  <StackPanel Spacing="12" MaxWidth="640">
    <controls:PageHeader Title="{Binding Title}" />
    <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" FontSize="15" />
    <TextBlock Text="{Binding StatusMessage}"
               Classes="muted"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
