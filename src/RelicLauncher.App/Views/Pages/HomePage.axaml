<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelicLauncher.App.ViewModels"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             x:Class="RelicLauncher.App.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel">

  <Grid>
    <Panel>
      <Border Background="{DynamicResource Theme.HeroBackground}" />
      <Border Background="{DynamicResource Theme.Fog}" />
      <Image Source="{Binding BackgroundLogo}"
             IsVisible="{Binding ShowBackgroundLogo}"
             Opacity="{Binding BackgroundLogoOpacity}"
             Stretch="Uniform"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             MaxWidth="620"
             MaxHeight="620"
             IsHitTestVisible="False" />
    </Panel>

    <Grid RowDefinitions="Auto,*" Margin="28,24,28,24">
      <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
        <TextBlock Text="Launch" Classes="brand" FontSize="32" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="primary"
                  Content="{Binding PlayButtonText}"
                  Command="{Binding PlayCommand}"
                  MinWidth="120"
                  AutomationProperties.Name="Play Vintage Story" />
          <ComboBox ItemsSource="{Binding InstalledVersions}"
                    SelectedItem="{Binding SelectedInstalledVersion}"
                    MinWidth="140"
                    PlaceholderText="Version"
                    IsEnabled="{Binding HasInstalledVersions}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Installed version" />
          <Button Classes="ghost"
                  Content="Sign in"
                  Command="{Binding GoToSignInCommand}"
                  IsVisible="{Binding ShowSignInPrompt}"
                  VerticalAlignment="Center"
                  MinWidth="100"
                  AutomationProperties.Name="Sign in" />
          <Button Classes="ghost"
                  Content="Go to Versions"
                  Command="{Binding GoToVersionsCommand}"
                  IsVisible="{Binding ShowGoToVersions}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Go to Versions" />
        </StackPanel>
        <TextBlock Text="{Binding ActiveVersionLabel}"
                   Classes="muted"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}"
                   Classes="muted"
                   Classes.error="{Binding StatusIsError}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Grid Grid.Row="1">
        <ScrollViewer IsVisible="{Binding !IsShowingArticle}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Vintage Story news" Classes="brand" FontSize="24" />
              <Button Classes="ghost"
                      Content="Retry"
                      Command="{Binding RetryNewsCommand}"
                      IsVisible="{Binding NewsStatusIsError}"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Retry loading news" />
            </StackPanel>

            <TextBlock Text="{Binding NewsStatusMessage}"
                       Classes="muted"
                       Classes.error="{Binding NewsStatusIsError}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       IsVisible="{Binding NewsStatusIsError}" />

            <Grid MinHeight="120">
              <controls:LoadingOverlay IsActive="{Binding IsLoadingNews}"
                                       Message="Loading news…" />
              <controls:EmptyStatePanel Message="{Binding NewsStatusMessage}"
                                        IsActive="{Binding ShowNewsEmpty}" />
              <ItemsControl ItemsSource="{Binding NewsArticles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NewsArticleViewModel">
                    <Button Classes="news-row"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,4"
                            Command="{Binding OpenCommand}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}"
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PublishedLabel}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding PublishedLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsShowingArticle}">
          <StackPanel Spacing="14">
            <Button Classes="ghost"
                    HorizontalAlignment="Left"
                    Content="Back to news"
                    Command="{Binding CloseArticleCommand}" />

            <TextBlock Text="{Binding SelectedArticleTitle}"
                       Classes="brand"
                       FontSize="24"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding SelectedArticlePublished}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SelectedArticlePublished, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="Loading article…"
                       Classes="muted"
                       IsVisible="{Binding IsLoadingArticle}" />

            <ItemsControl ItemsSource="{Binding SelectedArticleBlocks}"
                          IsVisible="{Binding !IsLoadingArticle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NewsContentBlockViewModel">
                  <StackPanel Spacing="10" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               IsVisible="{Binding IsText}" />

                    <StackPanel Spacing="6" IsVisible="{Binding IsImage}">
                      <TextBlock Text="Loading image…"
                                 Classes="muted"
                                 IsVisible="{Binding IsImageLoading}" />
                      <Image Source="{Binding Image}"
                             MaxWidth="760"
                             Stretch="Uniform"
                             IsVisible="{Binding !IsImageLoading}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding IsVideo}">
                      <Image Source="{Binding Image}"
                             MaxWidth="760"
                             Stretch="Uniform"
                             IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Button Classes="ghost"
                              HorizontalAlignment="Left"
                              Content="Watch video"
                              Command="{Binding OpenMediaCommand}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
