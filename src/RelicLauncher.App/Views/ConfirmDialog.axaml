<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RelicLauncher.App.ViewModels"
        x:Class="RelicLauncher.App.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{Binding Title}">

  <Grid RowDefinitions="Auto,Auto" Margin="24">
    <TextBlock Grid.Row="0"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               FontSize="15"
               Margin="0,0,0,20"
               AutomationProperties.Name="{Binding Message}" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Classes="ghost"
              Content="{Binding CancelText}"
              Command="{Binding CancelCommand}"
              AutomationProperties.Name="{Binding CancelText}" />
      <Button Classes="primary"
              Content="{Binding ConfirmText}"
              Command="{Binding ConfirmCommand}"
              AutomationProperties.Name="{Binding ConfirmText}" />
    </StackPanel>
  </Grid>
</Window>
