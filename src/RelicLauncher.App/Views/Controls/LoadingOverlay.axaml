<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RelicLauncher.App.Views.Controls"
             x:Class="RelicLauncher.App.Views.Controls.LoadingOverlay"
             x:Name="LoadingOverlayRoot"
             x:DataType="controls:LoadingOverlay"
             IsHitTestVisible="False">
  <Border Background="{DynamicResource Theme.Bg0}"
          Opacity="0.88"
          IsVisible="{Binding #LoadingOverlayRoot.IsActive}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
    <StackPanel Spacing="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="360"
                Margin="24">
      <ProgressBar IsIndeterminate="True"
                   Height="4"
                   Width="180"
                   HorizontalAlignment="Center" />
      <TextBlock Text="{Binding #LoadingOverlayRoot.Message}"
                 Classes="muted"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 FontSize="16"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Border>
</UserControl>
