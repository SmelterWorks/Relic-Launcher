<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RelicLauncher.App.ViewModels"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="RelicLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1024" Height="768"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Title="Relic Launcher"
        Icon="/Assets/Icons/icon.ico"
        AutomationProperties.Name="Relic Launcher">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateHomeCommand}" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateVersionsCommand}" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateModsCommand}" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateBackupCommand}" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateWikiCommand}" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateAboutCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="240,*"
        Opacity="{Binding ShellOpacity}">
    <Grid.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
      </Transitions>
    </Grid.Transitions>
    <Border Grid.Column="0"
            Background="{DynamicResource Theme.Bg1}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="0,0,1,0"
            Padding="16,12"
            AutomationProperties.Name="Main navigation">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,18">
          <TextBlock Text="Relic" Classes="brand" FontSize="28" />
          <TextBlock Text="Launcher" Classes="muted" FontSize="14" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding AppVersion, StringFormat=v{0} Unofficial Launcher}"
                   Classes="muted"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,4"
                   AutomationProperties.Name="{Binding AppVersion, StringFormat=Version {0} Unofficial Launcher}" />

        <StackPanel Spacing="8">
          <Button Classes="nav"
                  Classes.active="{Binding IsHomeActive}"
                  Command="{Binding NavigateHomeCommand}"
                  ToolTip.Tip="Home (Ctrl+1)"
                  AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <i:Icon Value="mdi-home" Width="22" Height="22" />
              <TextBlock Text="Home" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.active="{Binding IsVersionsActive}"
                  Command="{Binding NavigateVersionsCommand}"
                  ToolTip.Tip="Versions (Ctrl+2)"
                  AutomationProperties.Name="Versions">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <i:Icon Value="mdi-package-variant" Width="22" Height="22" />
              <TextBlock Text="Versions" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
          </Button>
        <Button Classes="nav"
                Classes.active="{Binding IsModsActive}"
                Command="{Binding NavigateModsCommand}"
                ToolTip.Tip="Mods (Ctrl+3)"
                AutomationProperties.Name="Mods">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <i:Icon Value="mdi-puzzle" Width="22" Height="22" />
            <TextBlock Text="Mods" VerticalAlignment="Center" FontSize="16" />
          </StackPanel>
        </Button>
        <Button Classes="nav"
                Classes.active="{Binding IsBackupActive}"
                Command="{Binding NavigateBackupCommand}"
                ToolTip.Tip="Backup (Ctrl+4)"
                AutomationProperties.Name="Backup">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <i:Icon Value="mdi-archive" Width="22" Height="22" />
            <TextBlock Text="Backup" VerticalAlignment="Center" FontSize="16" />
          </StackPanel>
        </Button>
        <Button Classes="nav"
                Classes.active="{Binding IsWikiActive}"
                Command="{Binding NavigateWikiCommand}"
                ToolTip.Tip="Wiki (Ctrl+5)"
                AutomationProperties.Name="Wiki">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <i:Icon Value="mdi-book-open-page-variant" Width="22" Height="22" />
            <TextBlock Text="Wiki" VerticalAlignment="Center" FontSize="16" />
          </StackPanel>
        </Button>
        <Button Classes="nav"
                Classes.active="{Binding IsSettingsActive}"
                Command="{Binding NavigateSettingsCommand}"
                ToolTip.Tip="Settings (Ctrl+6)"
                AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <i:Icon Value="mdi-cog" Width="22" Height="22" />
            <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="16" />
          </StackPanel>
        </Button>
        <Button Classes="nav"
                Classes.active="{Binding IsAboutActive}"
                Command="{Binding NavigateAboutCommand}"
                ToolTip.Tip="About (Ctrl+7)"
                AutomationProperties.Name="About">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <i:Icon Value="mdi-information" Width="22" Height="22" />
            <TextBlock Text="About" VerticalAlignment="Center" FontSize="16" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>

    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentPage}"
                    Padding="{Binding ContentPadding}"
                    AutomationProperties.Name="Page content" />
  </Grid>
</Window>
