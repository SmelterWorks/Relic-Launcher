<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RelicLauncher.App.ViewModels"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="RelicLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Title="Relic Launcher"
        Icon="/Assets/Icons/icon.ico"
        Opacity="{Binding ShellOpacity}"
        AutomationProperties.Name="Relic Launcher">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateHomeCommand}" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateVersionsCommand}" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateModsCommand}" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateAboutCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0"
            Background="{DynamicResource Theme.Bg1}"
            BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="0,0,1,0"
            Padding="16,12"
            AutomationProperties.Name="Main navigation">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,18">
          <TextBlock Text="Relic" Classes="brand" FontSize="28" />
          <TextBlock Text="Launcher" Classes="muted" FontSize="14" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding AppVersion, StringFormat=v{0} Unofficial Launcher}"
                   Classes="muted"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,4"
                   AutomationProperties.Name="{Binding AppVersion, StringFormat=Version {0} Unofficial Launcher}" />

        <StackPanel Spacing="6">
          <Button Classes="nav"
                  Classes.active="{Binding IsHomeActive}"
                  Command="{Binding NavigateHomeCommand}"
                  AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <i:Icon Value="mdi-home" Width="18" Height="18" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.active="{Binding IsVersionsActive}"
                  Command="{Binding NavigateVersionsCommand}"
                  AutomationProperties.Name="Versions">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <i:Icon Value="mdi-package-variant" Width="18" Height="18" />
              <TextBlock Text="Versions" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.active="{Binding IsModsActive}"
                  Command="{Binding NavigateModsCommand}"
                  AutomationProperties.Name="Mods">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <i:Icon Value="mdi-puzzle" Width="18" Height="18" />
              <TextBlock Text="Mods" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.active="{Binding IsSettingsActive}"
                  Command="{Binding NavigateSettingsCommand}"
                  AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <i:Icon Value="mdi-cog" Width="18" Height="18" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.active="{Binding IsAboutActive}"
                  Command="{Binding NavigateAboutCommand}"
                  AutomationProperties.Name="About">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <i:Icon Value="mdi-information" Width="18" Height="18" />
              <TextBlock Text="About" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentPage}"
                    Padding="{Binding ContentPadding}"
                    AutomationProperties.Name="Page content" />
  </Grid>
</Window>
