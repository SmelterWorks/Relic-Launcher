<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RelicLauncher.App</RootNamespace>
    <ApplicationIcon>Assets\Icons\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(PublishSingleFile)' == 'true'">none</DebugType>
    <DebugSymbols Condition="'$(PublishSingleFile)' == 'true'">false</DebugSymbols>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <Target Name="RemoveSingleFilePublishPdbs" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PublishPdbFiles Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbFiles)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="RelicLauncher.Bootstrap" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RelicLauncher.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RelicLauncher.Core\RelicLauncher.Core.csproj" />
    <ProjectReference Include="..\RelicLauncher.Infrastructure\RelicLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\RelicLauncher.Themes\RelicLauncher.Themes.csproj" />
  </ItemGroup>

  <Target Name="CopyRelicSandbox" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\relic-sandbox\relic-sandbox')">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory)..\..\native\relic-sandbox\relic-sandbox"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Optris.Icons.Avalonia" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
