<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RelicLauncher.App.Views.Controls">

  <Style Selector="controls|RelicComboBox">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|RelicComboBox.combo-fill">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|RelicComboBox:pointerover Border#Chrome">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
  </Style>

  <Style Selector="controls|RelicComboBox:focus-within Border#Chrome">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
  </Style>

</Styles>
