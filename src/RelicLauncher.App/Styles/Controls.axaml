<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg0}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Theme.FontBody}" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="FontFamily" Value="{DynamicResource Theme.FontDisplay}" />
    <Setter Property="FontSize" Value="42" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Bg0}" />
    <Setter Property="Padding" Value="28,12" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.AccentHover}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Background" Value="{DynamicResource Theme.AccentMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
  </Style>

  <Style Selector="Button.window-chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.window-chrome:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
  </Style>

  <Style Selector="Button.window-chrome.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Danger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <Style Selector="Button.hosting-tab, Button.segmented-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.hosting-tab.active, Button.segmented-tab.active">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
  </Style>

  <Style Selector="Border.list-row">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover Border.list-row">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.list-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.news-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.news-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
  </Style>

  <Style Selector="Border.status-badge.active">
    <Setter Property="Background" Value="{DynamicResource Theme.AccentMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.status-badge.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.hosting-panel">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.hosting-console">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.hosting-status-pill">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.hosting-status-pill TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.hosting-plan-card">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.hosting-plan-card-header">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="Border.hosting-plan-card-body">
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox:focus-visible /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TabItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Theme.AccentMuted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabControl.mods-tabs">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="12,8,12,12" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
  </Style>

  <Style Selector="TabControl.mods-tabs TabItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Padding" Value="0,0,10,0" />
  </Style>

  <Style Selector="Button.settings-section-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.settings-section-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
  </Style>

  <Style Selector="Button.settings-section-header:pressed">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
  </Style>

  <Style Selector="i|Icon.settings-section-chevron">
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
  </Style>

  <Style Selector="TextBlock.settings-field-label">
    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.settings-field-hint">
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #40000000" />
  </Style>

  <Style Selector="Border.toast.info">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
  </Style>

  <Style Selector="Border.toast.success">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
  </Style>

  <Style Selector="Border.toast.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Warning}" />
  </Style>

  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Danger}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.filter-bar">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Border.detail-panel">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.tag-chip">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Border.tag-chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.pagination-bar">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.page-header-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>

  <Style Selector="Button.news-card">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.news-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource Theme.Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
  </Style>

  <Style Selector="Border.theme-swatch">
    <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:selected Border.theme-swatch">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ListBoxItem:pointerover Border.theme-swatch">
    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentMuted}" />
  </Style>

</Styles>
